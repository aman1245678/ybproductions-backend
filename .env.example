# Root env template (workspace app also has yashvi-bagga-productions/.env.example)
PORT=4200
NODE_ENV=development
LOG_LEVEL=info
SITE_URL=http://localhost:4200
# Optional external CRM base URL for the Angular app in browser mode.
# Unused during `npm test` — unit/server suites mock outbound HTTP and never call this host.
API_URL=http://localhost:5041/api/v1
SENTRY_DSN=
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-in-local-env
