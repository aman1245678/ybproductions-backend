{
  "name": "yashvi-bagga-productions",
  "version": "1.0.0",
  "description": "Premium cinematic website for Yashvi Bagga Productions - Luxury Creative Media & Digital Production Agency",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false --code-coverage --browsers=ChromeHeadlessNoSandbox",
    "test:server": "c8 --check-coverage --lines 70 --reporter=text-summary --reports-dir=coverage/server node ../scripts/run-server-tests.mjs",
    "test:all": "npm run test && npm run test:server",
    "lint": "eslint . --ext .ts,.js,.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "start:prod": "node scripts/serve-prod.mjs",
    "serve:ssr": "node dist/yashvi-bagga-productions/server/server.mjs",
    "build:ssr": "ng build && ng run yashvi-bagga-productions:server"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^20.0.0",
    "@angular/common": "^20.0.0",
    "@angular/compiler": "^20.0.0",
    "@angular/core": "^20.0.0",
    "@angular/forms": "^20.0.0",
    "@angular/platform-browser": "^20.0.0",
    "@angular/platform-server": "^20.0.0",
    "@angular/router": "^20.0.0",
    "@angular/ssr": "^20.0.0",
    "@sentry/node": "^9.0.0",
    "express": "^4.18.2",
    "gsap": "^3.12.5",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.6.0",
    "zod": "^3.24.2",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^20.0.0",
    "@angular/cli": "^20.3.34",
    "@angular/compiler-cli": "^20.0.0",
    "@types/express": "^4.17.21",
    "@types/jasmine": "^5.1.7",
    "@types/node": "^20.11.0",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.24.0",
    "@typescript-eslint/parser": "^8.24.0",
    "autoprefixer": "^10.4.17",
    "eslint": "^8.57.1",
    "jasmine-core": "^5.5.0",
    "karma": "^6.4.4",
    "karma-chrome-launcher": "^3.2.0",
    "karma-coverage": "^2.2.1",
    "karma-jasmine": "^5.1.0",
    "karma-jasmine-html-reporter": "^2.1.0",
    "postcss": "^8.4.33",
    "supertest": "^7.0.0",
    "c8": "^10.1.3",
    "tailwindcss": "^3.4.1",
    "typescript": "~5.8.0"
  }
}

