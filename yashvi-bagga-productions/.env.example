# Dev server / Express host
PORT=4200
NODE_ENV=development
LOG_LEVEL=info

# Public site URL (canonical links, SSR origin)
SITE_URL=http://localhost:4200

# Optional external CRM base URL for ng serve browser calls.
# Unused during `npm test` / `npm run test:server` — no live network required.
API_URL=http://localhost:5041/api/v1

# Optional error tracking — leave empty to disable Sentry
SENTRY_DSN=

# Express host admin login (POST /api/v1/auth/login)
# Replace placeholders locally — never commit real secrets.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-in-local-env
JWT_SECRET=local-dev-jwt-secret-change-me
JWT_EXPIRES_SECONDS=3600
STORE_DRIVER=memory
DATA_DIR=./data
