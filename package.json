{
  "name": "ybproductions-backend",
  "version": "1.7.0",
  "private": true,
  "description": "Express API (JWT auth, application intake, user directory) with an Angular 20 marketing SPA host",
  "keywords": [
    "angular",
    "frontend",
    "web-app",
    "backend",
    "express",
    "nodejs",
    "typescript",
    "zod",
    "pino",
    "supertest",
    "karma",
    "jasmine"
  ],
  "workspaces": [
    "yashvi-bagga-productions"
  ],
  "scripts": {
    "start": "npm run start -w yashvi-bagga-productions",
    "build": "npm run build -w yashvi-bagga-productions",
    "test": "npm run test:unit && npm run test:server",
    "test:unit": "npm run test -w yashvi-bagga-productions",
    "test:server": "npm run test:server -w yashvi-bagga-productions",
    "lint": "npm run lint -w yashvi-bagga-productions",
    "typecheck": "npm run typecheck -w yashvi-bagga-productions",
    "format:check": "prettier --check \"README.md\" \"PROJECT_TYPE.md\" \"CHANGELOG.md\" \"DEPENDENCIES.md\""
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@sentry/node": "^9.0.0",
    "express": "^4.18.2",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "c8": "^10.1.3",
    "jasmine-core": "^5.5.0",
    "karma": "^6.4.4",
    "prettier": "^3.5.3",
    "supertest": "^7.0.0"
  }
}
